# Copy this file to .env.acceptance.local. Never commit the local copy.
# Replace every REPLACE_WITH value before a runtime is started.

HUAYI_API_ORIGIN=https://api.acceptance.localhost:8444
HUAYI_WEB_ORIGIN=https://app.acceptance.localhost:8443
VITE_API_ORIGIN=https://api.acceptance.localhost:8444
SUPABASE_URL=https://supabase.acceptance.localhost:8445

HUAYI_DATABASE_URL=REPLACE_WITH_LOCAL_DATABASE_URL
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_LOCAL_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LOCAL_SERVICE_ROLE_KEY

# Generate independent values with `pnpm acceptance:local:bootstrap`.
HUAYI_REFRESH_ENCRYPTION_KEY=REPLACE_WITH_BASE64URL_32_BYTE_KEY
HUAYI_SECRET_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CRON_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
HUAYI_SECURITY_NOTIFICATION_MODE=disabled-local-acceptance

# These fixed acceptance identifiers will be generated and frozen with the Store profile.
HUAYI_STORE_EXTENSION_ID=REPLACE_WITH_32_CHARACTER_ACCEPTANCE_EXTENSION_ID
HUAYI_MIN_SUPPORTED_EXTENSION_VERSION=1.0.0
HUAYI_ACCOUNT_EXPORT_BUCKET=account-exports-acceptance

# Intentionally omit HUAYI_DEEPSEEK_API_KEY until the disabled/fake local composition exists.
# This keeps the current production composition failed closed instead of allowing outbound traffic.
HUAYI_DEEPSEEK_LEGACY_PRICE_VERSION_ID=REPLACE_WITH_LOCAL_LEGACY_PRICE_UUID
HUAYI_DEEPSEEK_OFF_PEAK_PRICE_VERSION_ID=REPLACE_WITH_LOCAL_OFF_PEAK_PRICE_UUID
HUAYI_DEEPSEEK_PEAK_PRICE_VERSION_ID=REPLACE_WITH_LOCAL_PEAK_PRICE_UUID
