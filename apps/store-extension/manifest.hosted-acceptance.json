{
  "manifest_version": 3,
  "name": "语见 · Seen & Said",
  "version": "1.0.0",
  "description": "Turn what you see into what you can say. 面向中文英语学习者的网页划词翻译与本地生词本。",
  "incognito": "not_allowed",
  "permissions": ["alarms", "storage", "unlimitedStorage"],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://api.frdic.com/*",
    "https://api.acceptance.seen-said.cn/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["overlay.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://youtube.com/*", "https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["youtube-content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://youtube.com/*", "https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["youtube-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://api.openai.com https://api.deepseek.com https://api.frdic.com https://api.acceptance.seen-said.cn"
  },
  "key": ""
}
